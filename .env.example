ASPNETCORE_ENVIRONMENT=Production
PORT=10000
ConnectionStrings__DefaultConnection=Host=your-host;Port=5432;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=postgres://user:password@host:5432/database
Jwt__Issuer=MonsoonMasala
Jwt__Audience=MonsoonMasalaAdmin
Jwt__Secret=replace-with-at-least-32-random-characters
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-api-key
Cloudinary__ApiSecret=your-api-secret
Cloudinary__Folder=monsoon-masala/dishes
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=5

ASPNETCORE_ENVIRONMENT=Production
PORT=10000
ConnectionStrings__DefaultConnection=Host=your-host;Port=5432;Database=your-db;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=postgres://user:password@host:5432/database
Jwt__Issuer=SeraphineFlowers
Jwt__Audience=SeraphineFlowersAdmin
Jwt__Secret=replace-with-at-least-32-random-characters
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-api-key
Cloudinary__ApiSecret=your-api-secret
Cloudinary__Folder=seraphine-flowers/media
Cloudinary__AdvertisementFolder=seraphine-flowers/promo
Storefront__RequireCustomerOtp=false
Storefront__Offer__WelcomeDiscount=50
Storefront__Offer__LoyaltyDiscount=100
Storefront__Offer__LoyaltyEvery=5
Storefront__Cloudinary__GalleryFolder=Seraphine-Gallery
Storefront__Cloudinary__TrendingFolder=Seraphine-Trending
Storefront__Cloudinary__CustomerCollectionFolder=Seraphine-CustomerCollection
Storefront__Cloudinary__PromoAdsFolder=Seraphine-PromoAds
Storefront__Imports__Customers__Folder=Seraphine-Customers
Storefront__Imports__Customers__PublicId=seraphine-customers.json
Storefront__Imports__Reviews__Folder=Seraphine-Customers
Storefront__Imports__Reviews__PublicId=seraphine-reviews.json
Storefront__Imports__Flagged__Folder=Seraphine-Customers
Storefront__Imports__Flagged__PublicId=seraphine-flagged.json
Storefront__Imports__Analytics__Folder=Seraphine-Analytics
Storefront__Imports__Analytics__PublicId=seraphine-analytics.json
Storefront__Imports__Promo__Folder=Seraphine-PromoAds
Storefront__Imports__Promo__PublicId=seraphine-promo.json
Storefront__Imports__GalleryConfig__Folder=Seraphine-Gallery
Storefront__Imports__GalleryConfig__PublicId=seraphine-config.json
Storefront__Imports__TrendingConfig__Folder=Seraphine-Trending
Storefront__Imports__TrendingConfig__PublicId=seraphine-config.json
Storefront__Imports__CustomerCollectionConfig__Folder=Seraphine-CustomerCollection
Storefront__Imports__CustomerCollectionConfig__PublicId=seraphine-config.json
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=5
